PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Frontend origin for CORS
CORS_ORIGIN=https://localhost

# Firestore project
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
FIRESTORE_COLLECTION_MESSAGES=messages
FIRESTORE_COLLECTION_INBOX=inbox
FIRESTORE_COLLECTION_CONTACTS=contacts

# Optional local service account JSON for local development
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Vertex AI — used server-side for matching + gratitude summaries only
# Chat inference runs on-device via MediaPipe Gemma (no server call)
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL=gemma-3-12b-it

# Optional dev simulator
ENABLE_DEV_ROUTES=true
