  │       ├── categories.ts
  │       └── config.ts
  ├── assets/                # Icons, fonts, images
  ├── docs/                  # Documentation
  │   ├── architecture.md
  │   ├── message-format.md
  │   ├── privacy-model.md
  │   └── ui-flows.md
  ├── package.json
  ├── tsconfig.json
  └── README.md

important_files:
  - "schemas/message-schema.json": Complete JSON schema for all message types
  - "types/message.ts": TypeScript definitions matching schema
  - "services/crypto/messageEncryption.ts": Multi-payload encryption logic
  - "services/matching/densityCalculator.ts": Network density for adaptive privacy
  - "constants/categories.ts": All category enums and attributes

development_priorities:
  phase_1_mvp:
    - Message schema validation
    - Local storage of messages
    - Basic BLE broadcast/receive
    - Simple request/offer creation
    - Message list display
    - Direct coordination (no encryption yet)
  
  phase_2_core:
    - Encryption (single recipient)
    - Key management
    - Multi-payload encryption
    - Message relay/flooding
    - Network density calculation
    - Adaptive location precision
  
  phase_3_enhanced:
    - Broker system
    - Good news broadcasts
    - QR code generation
    - Map integration
    - Wizard UI refinement
  
  phase_4_polish:
    - Accessibility features
    - Offline queue optimization
    - UI animations
    - Onboarding flow
    - Testing & bug fixes

coding_guidelines:
  - Use TypeScript strict mode
  - Follow functional programming patterns where possible
  - Encrypt all sensitive data at rest
  - Never log decrypted payloads
  - Validate all incoming messages against schema
  - Use enums from constants, never hard-code strings
  - Keep components small and focused
  - Write tests for crypto and matching logic
  - Comment complex privacy/security logic
  - Graceful degradation for missing features

security_requirements:
  - Never store private keys unencrypted
  - Use libsodium for all crypto (X25519, XSalsa20-Poly1305)
  - Generate new keypair per message (ephemeral)
  - Pad all encrypted payloads to standard sizes
  - Clear sensitive data from memory after use
  - No analytics or tracking
  - No network requests except BLE
  - Validate all message fields
  - Rate-limit message creation

accessibility_requirements:
  - Minimum 44x44pt tap targets
  - High contrast mode support
  - Screen reader compatibility
  - Large text support
  - Voice input for limited typing
  - Icon + text for all actions
  - Simple language throughout
  - Error messages that help

testing_strategy:
  unit_tests:
    - Message validation
    - Encryption/decryption
    - Key generation
    - Category attribute validation
    - Location precision calculation
  
  integration_tests:
    - Message creation → storage → retrieval
    - Encryption → BLE send → receive → decryption
    - Matching logic
    - Relay functionality
  
  manual_testing:
    - UI flows (wizard, coordination)
    - BLE range and reliability
    - Multi-device message propagation
    - Battery usage
    - Offline functionality

reference_documents:
  - "This conversation document": Complete design discussion and requirements
  - "JSON Schema": schemas/message-schema.json
  - "UI Flow sketches": In conversation, screens section
  - "User requirements": In conversation, UX requirements section

notes_for_claude:
  - Prioritize privacy and security in all decisions
  - When in doubt about UX, favor simplicity and dignity
  - Remember: no free-text fields (except building/unit identifiers)
  - Categories and attributes must use enums only
  - Location precision must adapt to network density
  - Messages must be relayed for privacy (flooding)
  - Encryption is multi-recipient (array of payloads)
  - No server/backend - everything local and P2P