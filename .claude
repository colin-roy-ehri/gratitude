  │   │   ├── HomeScreen.tsx
  │   │   ├── RequestWizard/
  │   │   ├── OfferWizard/
  │   │   ├── CoordinationScreen.tsx
  │   │   └── ActivityScreen.tsx
  │   ├── services/          # Core logic
  │   │   ├── crypto/
  │   │   │   ├── keyManagement.ts
  │   │   │   ├── encryption.ts
  │   │   │   └── messageEncryption.ts
  │   │   ├── ble/
  │   │   │   ├── bleManager.ts
  │   │   │   ├── messageRelay.ts
  │   │   │   └── deviceDiscovery.ts
  │   │   ├── storage/
  │   │   │   ├── messageStore.ts
  │   │   │   └── keyStore.ts
  │   │   └── matching/
  │   │       ├── matcher.ts
  │   │       └── densityCalculator.ts
  │   ├── types/             # TypeScript definitions
  │   │   ├── message.ts
  │   │   ├── category.ts
  │   │   └── encryption.ts
  │   ├── schemas/           # JSON schemas
  │   │   └── message-schema.json
  │   ├── utils/             # Utility functions
  │   │   ├── validation.ts
  │   │   ├── formatting.ts
  │   │   └── privacy.ts
